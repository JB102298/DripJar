modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]

[userenv.production]
ALLOWED_ORIGINS = "https://m3jar.com,https://www.m3jar.com"
APP_BASE_URL = "https://m3jar.com"
EXPO_PUBLIC_DOMAIN = "m3jar.com"
EMAIL_FROM = "DripJar <noreply@updates.thedripjar.com>"
